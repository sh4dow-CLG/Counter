<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Counter.Views.CounterPage"
             xmlns:models ="clr-namespace:Counter.Models"
             x:DataType="models:Counter"
             Title="{Binding Name}">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Label Text="{Binding Name}" FontSize="32" />
        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
            <Button Grid.Column="0"
                    Text="-"
                    Clicked="SubtractButton_Clicked" />
            <Label x:Name="Number"
                   Grid.Column="1"
                   FontSize="32"
                   Text="{Binding Value}"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center" />
            <Button Grid.Column="2"
                    Text="+"
                    Clicked="AdditionButton_Clicked" />
        </Grid>

        <Label Text="Autor: Franciszek Wawrzeń" />
    </VerticalStackLayout>
</ContentPage>
