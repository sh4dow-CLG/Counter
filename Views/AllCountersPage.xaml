<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Counter.Models"
             x:Class="Counter.Views.AllCountersPage"
             x:DataType="models:AllCounters"
             Title="Liczniki">
    <Grid Padding="20"
          RowDefinitions="Auto, *"
          RowSpacing="12">
        <Grid Grid.Row="0"
              ColumnDefinitions="*, Auto"
              ColumnSpacing="8">
            <Entry x:Name="NameEntry"
                   Grid.Column="0"
                   Placeholder="Nazwa licznika" />
            <Button Grid.Column="1"
                    Text="Stwórz licznik"
                    Clicked="Add_counter_clicked" />
        </Grid>
    </Grid>

    <CollectionView x:Name="countersCollection"
                    Grid.Row="1"
                    ItemsSource="{Binding Counters}"
                    SelectionMode="Single"
                    SelectionChanged="countersCollection_SelectionChanged"
                    EmptyView="Nie dodano jeszcze liczników.">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="models:Counter">
                <Grid Padding="12"
                  ColumnDefinitions="*,Auto"
                  ColumnSpacing="12">
                    <Label Grid.Column="0"
                       Text="{Binding Name}"
                       FontSize="22" />
                    <Label Grid.Column="1"
                           Text="{Binding Value}"
                           FontSize="22"/>
                </Grid>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>
